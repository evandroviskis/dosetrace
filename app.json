{
  "expo": {
    "name": "DoseTrace",
    "slug": "dosetrace",
    "scheme": "dosetrace",
    "version": "1.3.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json"
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#DDE0DB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.outcom.dosetrace",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSDocumentPickerUsageDescription": "DoseTrace needs access to your files to upload bloodwork and vaccine card PDFs.",
        "NSPhotoLibraryUsageDescription": "DoseTrace needs photo library access to upload photos of lab reports, vaccine cards, and vial labels.",
        "NSCameraUsageDescription": "DoseTrace needs camera access so you can snap a photo of a lab report, vaccine card, or vial label.",
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "es",
          "pt",
          "fr",
          "de",
          "it"
        ]
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#DDE0DB",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#121416"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C2340"
      },
      "edgeToEdgeEnabled": true,
      "package": "io.outcom.dosetrace",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "googleServicesFile": "./google-services.json",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#DDE0DB",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#121416"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#185FA5"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.488196840448-giqjcpns2k4ccal6lhdhqq0356niqb2t"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static"
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# expo-notifications: its keep rule is not shipped as a consumer rule; without it R8 strips the\n# private writeObject/readObject and every scheduled reminder fails (NotSerializableException).\n-keep class expo.modules.notifications.** { *; }\n-keepclassmembers class * implements java.io.Serializable {\n  static final long serialVersionUID;\n  private static final java.io.ObjectStreamField[] serialPersistentFields;\n  private void writeObject(java.io.ObjectOutputStream);\n  private void readObject(java.io.ObjectInputStream);\n  java.lang.Object writeReplace();\n  java.lang.Object readResolve();\n}\n# Notification actions with the app closed run JS through the headless app loader.\n-keep class expo.modules.adapters.react.apploader.** { *; }\n-keep class expo.modules.taskManager.** { *; }\n# A-111: the update receiver starts expo-background-task's worker by class name.\n-keep class expo.modules.backgroundtask.** { *; }"
          }
        }
      ],
      "expo-font",
      "./plugins/withAndroidBackupDisabled",
      "./plugins/withoutIosBackgroundFetch",
      "./plugins/withFoldConfigChanges",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#DDE0DB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121416"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4780e120-5f45-4482-8e95-b443929b6f8a"
      }
    }
  }
}
